# Copy to .env and fill in values — never commit .env

# Local paths to Excel fixtures (for dev/test without Google Sheets)
POSTING_BASE_PATH="docs/example-files/Posting Base Perdiem & Sector Allowance (Responses).xlsx"
LATE_SUBMISSION_PATH="docs/example-files/Late Submission Perdiem & Irregularity of Sector Allowance (Responses).xlsx"
# CCD payroll/master workbook — outcomes + identity for the ML dataset builder (PD-ML-002).
CCD_MASTER_PATH="docs/example-files/Posting Perdiem of CCD 2026.xlsx"

# ML dataset builder (PD-ML-002). Output is PII and stays local under the gitignored data/.
ML_DATASET_DIR=data/ml/datasets
DATASET_VERSION=
RATE_THB_PER_DAY=400

# Google Sheets workbook IDs (production)
POSTING_BASE_WORKBOOK_ID=
LATE_SUBMISSION_WORKBOOK_ID=

# Path to the Google service-account credentials JSON
GOOGLE_CREDENTIALS_PATH=secrets/google-credentials.json

# Database (PostgreSQL via psycopg3 — required for web/worker; engine tests work without it)
# Local dev (make backend-dev): use localhost — host.docker.internal does not resolve outside Docker.
# Docker compose overrides this value via its own environment: block, so this entry only matters for local dev.
DATABASE_URL=postgresql+psycopg://perdiem:change_me@localhost:5432/perdiem
POSTGRES_PASSWORD=change_me

# Shared Postgres admin credentials — used once by db-init to create the perdiem role + DB.
# Must be a superuser or a role with CREATEROLE + CREATEDB privileges.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change_me

# Web app authentication — single shared admin password (no username)
# Set to a strong random string; the API reads this at startup and never hard-codes it.
# Changing this value requires restarting the api container.
ADMIN_PASSWORD=

# JWT signing secret — set a stable value so tokens survive restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# File storage. Docker compose overrides these to /data/* via its own environment block
# (see docker-compose.yml), so the values below apply ONLY to local dev (make backend-dev).
# backend-dev runs from backend/, so ../data resolves to the gitignored repo-root data/.
UPLOADS_DIR=../data/uploads
REPORTS_DIR=../data/reports
ROSTER_CACHE_DIR=../data/cache

# Google Drive account for roster downloads (used by the worker via gcloud CLI)
# Must have run: python scripts/auth_drive.py  once on the host Pi.
DRIVE_ACCOUNT=kantaphajasuwan@airasia.com

# Triage classifier (PD-ML-004). Disabled by default until validated.
# Enable only after training and evaluating the model via scripts/train_triage.py.
TRIAGE_ENABLED=false
TRIAGE_MODEL_PATH=data/ml/models/triage.json
TRIAGE_AUTOPASS_MIN_CONF=0.85
TRIAGE_REVIEW_BAND=0.10

# Doc-type / quality classifier (PD-ML-005). Disabled by default until validated.
# Train with: make ml-train-doctype  (reads docs/example-files/ fixture images)
# Enable only after verifying the model on your fixture set.
DOCTYPE_ENABLED=false
DOCTYPE_MODEL_PATH=data/ml/models/doctype.json
DOCTYPE_MIN_CONF=0.70

# Donut roster reader (PD-ML-006). Disabled by default until a fine-tuned model exists.
# Train with: scripts/train in ml/donut/ (off-Pi, requires GPU + transformers).
# Point DONUT_MODEL_PATH at either:
#   - a HuggingFace model directory (config.json present) → torch inference
#   - a directory with *.onnx files → onnxruntime inference (Pi production)
DONUT_ENABLED=false
DONUT_MODEL_PATH=data/ml/models/donut
DONUT_CONF_FALLBACK=0.60
DONUT_MAX_PAGES=2

# Pluggable extractor backend (PD-ML-007).
# tesseract (default) — always available, no model needed
# donut               — pure Donut ML reader (requires trained model)
# hybrid              — Donut with Tesseract safety-net fallback (recommended roll-out mode)
OCR_BACKEND=tesseract
# OCR result cache — re-runs reuse cached extracted fields (N2 idempotency).
# Gitignored; change model version invalidates automatically.
OCR_CACHE_DIR=data/ml/ocr_cache
